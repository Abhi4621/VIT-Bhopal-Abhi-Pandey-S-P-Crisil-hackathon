# RiskPulse Environment Configuration Example
# Copy this file to .env and adjust variables as needed

PORT=8000
HOST=0.0.0.0
DEBUG=False
APP_NAME=RiskPulse
APP_VERSION=1.0.0
STRESS_TEST_THRESHOLD=7

# Database URL (defaults to SQLite in backend/database/riskpulse.db)
DATABASE_URL=sqlite:///backend/database/riskpulse.db

# Optional Live RSS Source URL (free public RSS feed)
LIVE_RSS_URL=https://finance.yahoo.com/news/rssindex
